backend/.venv/
# The infra scripts and emulator-backend.sh both use backend/venv (no dot).
backend/venv/
backend/**/__pycache__/
*.pyc
frontend/node_modules/
frontend/node_modules/.vite/
backend/emulator_runtime.json
# backend/emulator_config.json is intentionally TRACKED. It holds hand-entered
# RTD calibration and valve wiring that exists nowhere else. Do not re-ignore it.

# Deployment (see infra/README.md) — live and machine-specific, never committed.
# The tracked templates are infra/emulator.env.example and infra/frontend.env.example.
infra/emulator.env
infra/.node-path.env
frontend/.env.production
frontend/.env.local
frontend/dist/
frontend/.npm-cache/
*.log
.env
.env.*
!.env.example

# Generated by backend/tools/build_config_from_excel.py. The generator's own
# output and calibration map ARE tracked; its timestamped backups are not.
backend/tools/*.bak
backend/tools/__pycache__/
backend/tools/_roundtrip_probe.json
