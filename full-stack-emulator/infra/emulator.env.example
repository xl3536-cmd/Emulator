# =============================================================================
# Full Stack Emulator — service environment
# =============================================================================
# Copy to emulator.env NEXT TO THIS FILE, edit, then chmod 600:
#
#   cp emulator.env.example emulator.env && chmod 600 emulator.env
#
# Read by the systemd unit via `EnvironmentFile=`, and honoured by
# run-emulator-backend.sh and deploy-frontend.sh. Every value below has a
# working default baked into the runner, so an empty emulator.env is valid —
# this file exists so you can change one thing without editing shell scripts.
#
# IMPORTANT: the backend application itself reads NO environment variables.
# These values reach uvicorn as command-line flags, and reach the deploy step
# as shell variables. Do not expect the FastAPI app to pick up new keys you
# invent here.
# =============================================================================

# ------------------------------------------------------------------ backend ---

# Interface uvicorn binds. Keep 0.0.0.0 only if you want the backend reachable
# directly, bypassing nginx — useful for curl-from-laptop debugging. Set to
# 127.0.0.1 to force all traffic through the nginx proxy.
BACKEND_HOST=0.0.0.0

# uvicorn port. nginx/emulator.conf proxies /api/ to 127.0.0.1 on THIS port.
# If you change it here you MUST change it in nginx/emulator.conf too;
# install-emulator-service.sh warns when the two disagree.
BACKEND_PORT=8000

# uvicorn log level: critical | error | warning | info | debug | trace
# Everything goes to the journal: journalctl -u emulator-backend -f
BACKEND_LOG_LEVEL=info

# Free-form tag echoed into the startup banner and exported as APP_ENV.
APP_ENV=lab

# ----------------------------------------------------------------- frontend ---

# Directory nginx serves the built SPA from. Must match `root` in
# nginx/emulator.conf. install-emulator-service.sh creates it and gives it to
# the service user so the runner can deploy WITHOUT sudo.
FRONTEND_DEST=/var/www/emulator

# 1 = the service rebuilds and redeploys the frontend on every start
#     ("fast lab iteration": git pull && sudo systemctl restart emulator-backend
#     is the whole update procedure). Costs ~20-40s of startup on a Pi.
# 0 = the service only runs uvicorn; deploy the frontend yourself with
#     ./deploy-frontend.sh. Restarts become near-instant.
BUILD_FRONTEND=1

# 1 = run `npm ci` when node_modules is absent or package-lock.json is newer.
# 0 = never touch npm dependencies (offline Pi, or you manage them by hand).
INSTALL_FRONTEND_DEPS=1

# ------------------------------------------------------------------- config ---

# 1 = on start, if backend/emulator_config.json is missing, copy
#     infra/emulator_config.example.json into place first.
#
# Why this exists: backend/emulator_config.json is git-ignored (the UI mutates
# it through PUT /api/config), so a fresh clone has no config file. Without
# seeding, the backend calls build_default_config() and writes generic defaults
# — silently losing the real board/valve/Arctic-HP wiring. Leave this at 1.
SEED_CONFIG=1

# --------------------------------------------------------------------- node ---

# Absolute path to the npm binary. Leave commented to let the runner search
# (NPM -> nvm -> PATH). install-emulator-service.sh auto-detects npm for the
# service user and writes .node-path.env, which the unit also loads; that
# normally makes this unnecessary. Set it explicitly if npm is somewhere odd.
#NPM=/home/saxifrage/.config/nvm/versions/node/v20.11.1/bin/npm
