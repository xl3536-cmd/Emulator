# =============================================================================
# Full Stack Emulator — frontend build environment
# =============================================================================
# Copy to ../frontend/.env.production before building for nginx:
#
#   cp infra/frontend.env.example frontend/.env.production
#
# Vite inlines these at BUILD time, not run time. Changing this file has no
# effect until you rebuild (npm run build) and redeploy.
# =============================================================================

# Base URL prefixed to every API path in frontend/src/api/client.js.
#
# LEAVE THIS EMPTY for the nginx deployment. Empty means the browser requests
# same-origin relative paths (/api/config), which nginx proxies to the backend.
# That keeps the SPA and the API on one origin, so no CORS preflight and no
# hard-coded Pi IP baked into the bundle.
#
# Only set it when the frontend is served from a DIFFERENT origin than the API
# — e.g. running `npm run dev` on your laptop against a Pi:
#   VITE_API_BASE=http://192.168.68.50
VITE_API_BASE=
